# Copy this file to `.env` and set your own values:   cp .env.example .env
# `.env` is git-ignored: real secrets never go into the repository.

# --- PostgreSQL ---
POSTGRES_DB=jobtracker
POSTGRES_USER=jobtracker
POSTGRES_PASSWORD=change-me
# Port published on your machine (change it if 5432 is already taken).
POSTGRES_PORT=5432

# --- API ---
# Secret that signs the access tokens. At least 32 random characters, e.g.: openssl rand -base64 48
JWT_SIGNING_KEY=change-me-to-a-random-string-of-at-least-32-characters

# --- Demo data ---
# Creates demo@jobtracker.dev with 25 sample applications on first start.
SEED_DEMO_DATA=true
# Password of the demo account: 8+ characters with uppercase, lowercase and a digit.
DEMO_PASSWORD=Change-me-1

# --- Web ---
# The app will be at http://localhost:8080
WEB_PORT=8080
# Interactive API docs at http://localhost:8080/scalar
API_DOCS_ENABLED=true
