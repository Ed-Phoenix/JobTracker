# Copy this file to `.env` and adjust the values.
# `.env` is git-ignored: real secrets never go into the repository.

# --- PostgreSQL (used by docker-compose) ---
POSTGRES_DB=jobtracker
POSTGRES_USER=jobtracker
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- API (ASP.NET Core reads `Section__Key` as `Section:Key`) ---
ConnectionStrings__Default=Host=localhost;Port=5432;Database=jobtracker;Username=jobtracker;Password=change-me
